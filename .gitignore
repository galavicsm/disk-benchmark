# Go binaries and test artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof
coverage.*

# Wails build output and development metadata
/build/bin/
/frontend/package.json.md5

# Vite and TypeScript generated files
/frontend/node_modules/
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/.vite/
/frontend/coverage/
/frontend/*.tsbuildinfo
/frontend/vite.config.js
/frontend/vite.config.d.ts
/frontend/vite.config.js.map
/frontend/vite.config.d.ts.map

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files
.env
.env.*
!.env.example
!.env.*.example
*.local

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
