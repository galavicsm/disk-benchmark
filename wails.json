{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "version": "2",
  "name": "DiskBenchmark",
  "outputfilename": "DiskBenchmark",
  "build:dir": "build",
  "frontend:dir": "frontend",
  "frontend:install": "npm ci",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "bindings": {
    "ts_generation": {
      "outputType": "interfaces"
    }
  },
  "info": {
    "companyName": "DiskBenchmark",
    "productName": "DiskBenchmark",
    "productVersion": "1.0.0",
    "copyright": "Copyright (c) DiskBenchmark contributors",
    "comments": "Native disk benchmark application"
  }
}
